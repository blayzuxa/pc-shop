  headHtml: `<meta property="og:type" content="website"><meta property="og:locale" content="ru_RU"><meta property="og:title" content="Выкуп видеокарт и комплектующих в Краснодаре | ScoutPC"><meta property="og:description" content="Выкуп видеокарт, DDR4/DDR5, Ryzen, Intel, SSD, материнских плат и игровых ПК в Краснодаре. Оценка по фото, деньги сразу после проверки, доставка по России и Trade-in."><meta property="og:url" content="https://scoutpc.ru/vykup-videokart-i-komplektuyushchih-krasnodar.html"><meta property="og:image" content="https://scoutpc.ru/images/scoutpc-buyback-v2.avif"><meta property="og:image:alt" content="Персонаж ScoutPC с видеокартами и оперативной памятью"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="Выкуп видеокарт и комплектующих в Краснодаре | ScoutPC"><meta name="twitter:description" content="Выкуп видеокарт, DDR4/DDR5, Ryzen, Intel, SSD, материнских плат и игровых ПК в Краснодаре. Оценка по фото, деньги сразу после проверки, доставка по России и Trade-in."><meta name="twitter:image" content="https://scoutpc.ru/images/scoutpc-buyback-v2.avif">`
