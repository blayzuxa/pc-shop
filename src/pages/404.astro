---
import BaseLayout from '../layouts/BaseLayout.astro';

const page = {
  title: 'Страница не найдена | ScoutPC',
  description: 'Запрошенная страница не найдена. Перейдите в каталог игровых ПК или закажите индивидуальную сборку ScoutPC.',
  canonical: 'https://scoutpc.ru/404.html',
  head: '<meta name="robots" content="noindex,follow"><meta name="theme-color" content="#040406">',
};
---
<BaseLayout {...page} page="404" pageScript={false}>
  <main class="not-found">
    <a class="not-found-logo" href="/" aria-label="ScoutPC — главная">
      <img src="/images/optimized/logo-circle-192.webp" width="96" height="96" alt="ScoutPC" />
    </a>
    <p class="not-found-code">404</p>
    <h1>Такой страницы нет</h1>
    <p class="not-found-copy">Возможно, адрес изменился. Выберите готовый игровой ПК, рассчитайте индивидуальную сборку или вернитесь на главную.</p>
    <nav class="not-found-actions" aria-label="Полезные разделы">
      <a class="not-found-primary" href="/igrovye-kompyutery-krasnodar.html">Смотреть готовые ПК</a>
      <a href="/sborka-pk-krasnodar.html">Сборка на заказ</a>
      <a href="/">На главную</a>
    </nav>
  </main>
</BaseLayout>

<style>
  .not-found {
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 20px;
    padding: 48px 20px;
    text-align: center;
    color: #f5f7ff;
    background:
      radial-gradient(circle at 25% 20%, rgba(0, 229, 255, .16), transparent 34rem),
      radial-gradient(circle at 80% 70%, rgba(138, 43, 226, .18), transparent 32rem),
      #040406;
  }
  .not-found-logo img { border-radius: 50%; box-shadow: 0 0 45px rgba(0, 229, 255, .22); }
  .not-found-code { margin: 0; color: #00e5ff; font: 800 clamp(4rem, 14vw, 9rem)/.8 Inter, sans-serif; letter-spacing: -.08em; }
  .not-found h1 { margin: 0; font: 800 clamp(2rem, 6vw, 4rem)/1.05 Inter, sans-serif; }
  .not-found-copy { max-width: 680px; margin: 0; color: #b9bfd0; font: 500 1.05rem/1.7 Inter, sans-serif; }
  .not-found-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 12px; }
  .not-found-actions a { padding: 13px 20px; border: 1px solid rgba(255,255,255,.18); border-radius: 12px; color: #fff; text-decoration: none; font: 700 .95rem Inter, sans-serif; }
  .not-found-actions a:hover { border-color: #00e5ff; }
  .not-found-actions .not-found-primary { color: #041014; background: #00e5ff; border-color: #00e5ff; }
</style>
