---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../page-data.json';
import content from '../content/privacy-policy.html?raw';
import '../styles/privacy-policy.css';
import { enhanceNavigation } from '../lib/navigation';
const page = data['privacy-policy'];
const pageContent = enhanceNavigation(content);
---
<BaseLayout {...page} page="privacy-policy"><Fragment set:html={pageContent} /></BaseLayout>
