---
import BaseLayout from '../layouts/BaseLayout.astro';
import data from '../page-data.json';
import content from '../content/index.html?raw';
import '../styles/index.css';

const page = data.index;
const buybackUrl = '/vykup-videokart-i-komplektuyushchih-krasnodar.html';
const pageContent = content
  .replace(
    '<li><a href="#reviews">Отзывы</a></li>',
    `<li><a href="#reviews">Отзывы</a></li>\n<li><a href="${buybackUrl}">Выкуп железа</a></li>`,
  )
  .replace(
    '<a class="mobile-overlay-link" href="#reviews"><span>Отзывы</span><span class="arrow">→</span></a>',
    `<a class="mobile-overlay-link" href="#reviews"><span>Отзывы</span><span class="arrow">→</span></a>\n<a class="mobile-overlay-link" href="${buybackUrl}"><span>Выкуп железа</span><span class="arrow">→</span></a>`,
  );
---
<BaseLayout {...page} page="index"><Fragment set:html={pageContent} /></BaseLayout>
