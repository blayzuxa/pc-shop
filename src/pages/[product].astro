---
import BaseLayout from '../layouts/BaseLayout.astro';
import shell from '../content/apgreyd-i-obsluzhivanie-pk-krasnodar.html?raw';
import { enhanceNavigation } from '../lib/navigation';
import { products, shortCpu, shortGpu, type ProductFamily } from '../data/products';
import '../styles/apgreyd-i-obsluzhivanie-pk-krasnodar.css';
import '../styles/product.css';
import '../styles/contact.css';

export function getStaticPaths() {
  return products.map((product) => ({ params: { product: product.slug }, props: { product } }));
}

interface Props { product: ProductFamily }
const { product } = Astro.props;
const canonical = `https://scoutpc.ru/${product.slug}.html`;
const primary = product.variants.find((v) => v.platform === 'AMD') ?? product.variants[0];
const priceText = product.price.toLocaleString('ru-RU');
const cpuName = shortCpu(primary.cpu);
const gpuName = shortGpu(primary.gpu);
const h1Text = `Игровой ПК ${product.name} (${cpuName} / ${gpuName} / ${primary.memory})`;
const titleText = `Игровой ПК ${product.name} (${gpuName}, ${cpuName}) — купить в Краснодаре от ${priceText} ₽ | ScoutPC`;
const description = `Игровой ПК ${product.name} (${cpuName}, ${gpuName}): Краснодар, 3 часа стресс-тестов, гарантия 12 месяцев, доставка СДЭК. От ${priceText} ₽.`;
const firstSectionIndex = shell.indexOf('<section class="section hero-section"');
const footerIndex = shell.indexOf('<footer class="footer"');
const shellStart = enhanceNavigation((firstSectionIndex >= 0 ? shell.slice(0, firstSectionIndex) : '').replace(/<nav class="breadcrumb-nav"[\s\S]*?<\/nav>/, ''));
const shellEnd = enhanceNavigation(footerIndex >= 0 ? shell.slice(footerIndex) : '');
const faq = [
  { q: `Можно изменить конфигурацию ${product.name}?`, a: 'Да. Корпус, объём памяти, накопители, охлаждение и другие комплектующие можно изменить после консультации.' },
  { q: 'Комплектующие новые?', a: 'Состояние и точные модели всех комплектующих согласовываем до заказа. Бывшие в употреблении детали используем только по вашему согласованию.' },
  { q: 'Как проверяется готовый компьютер?', a: 'Перед выдачей проводим 3 часа стресс-тестов OCCT и FurMark, проверяем стабильность и температуры.' },
  { q: 'Можно заказать доставку?', a: 'Да. Отправляем по России через СДЭК; упаковку, страхование и условия оплаты согласовываем заранее.' },
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://scoutpc.ru/' },
      { '@type': 'ListItem', position: 2, name: 'Игровые компьютеры', item: 'https://scoutpc.ru/igrovye-kompyutery-krasnodar.html' },
      { '@type': 'ListItem', position: 3, name: product.name, item: canonical },
    ] },
    {
      '@type': 'Product', '@id': `${canonical}#product`,
      name: h1Text,
      description: `Игровой ПК ${product.name}: ${cpuName}, ${gpuName}, ${primary.memory}. Сборка ScoutPC в Краснодаре, 3 часа стресс-тестов, гарантия 12 месяцев.`,
      image: product.variants.map(v => `https://scoutpc.ru${v.image}`),
      brand: { '@type': 'Brand', name: 'ScoutPC' },
      category: 'Игровые компьютеры',
      aggregateRating: { '@type': 'AggregateRating', ratingValue: 5, reviewCount: 250, bestRating: 5, worstRating: 1 },
      subjectOf: { '@type': 'WebPage', name: 'Отзывы клиентов ScoutPC на Авито', url: 'https://www.avito.ru/brands/i206808792' },
      offers: {
        '@type': 'AggregateOffer',
        lowPrice: product.price, highPrice: product.price, priceCurrency: 'RUB',
        offerCount: product.variants.length, url: canonical,
        availability: 'https://schema.org/InStock',
        seller: { '@type': 'Organization', name: 'ScoutPC' },
      },
    },
    { '@type': 'FAQPage', mainEntity: faq.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
  ],
};
const head = `<meta name="theme-color" content="#040406"><meta property="og:type" content="product"><meta property="og:locale" content="ru_RU"><meta property="og:site_name" content="ScoutPC"><meta property="og:title" content="${titleText}"><meta property="og:description" content="${description}"><meta property="og:url" content="${canonical}"><meta property="og:image" content="https://scoutpc.ru/images/og/${product.slug}.jpg"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="${h1Text}"><meta name="twitter:card" content="summary_large_image"><script type="application/ld+json">${JSON.stringify(schema)}</script>`;
const price = product.price.toLocaleString('ru-RU');
---
<BaseLayout title={titleText} description={description} canonical={canonical} headHtml={head} page={product.slug} pageScript={false}>
  <Fragment set:html={shellStart} />
  <main>
    <nav class="product-breadcrumb" aria-label="Хлебные крошки"><a href="/">Главная</a><span>→</span><a href="/igrovye-kompyutery-krasnodar.html">Игровые ПК</a><span>→</span><span>{product.name}</span></nav>
    <section class="product-hero">
      <div class="product-hero-copy">
        <p class="product-kicker">SCOUTPC · КРАСНОДАР</p>
        <h1>Игровой ПК <span>{product.name}</span><span class="h1-specs">({cpuName} / {gpuName} / {primary.memory})</span></h1>
        <p class="product-lead">{product.summary}</p>
        <div class="product-price">от {price} ₽</div>
        <div class="product-actions"><a class="product-primary" href="https://t.me/Scout_PC" target="_blank">Обсудить конфигурацию</a><a href="tel:+79531171331">+7 953 117-13-31</a><a href="#variants">Сравнить AMD и Intel</a></div>
        <p class="product-note">Цена и состав ориентировочные. Точную смету и наличие согласуем перед заказом.</p>
      </div>
      <picture class="product-hero-image">
        <source media="(max-width: 640px)" srcset={product.variants[1].image480} />
        <img src={product.variants[1].image} width="960" height="1280" alt={`Игровой ПК ${product.name} на ${primary.platform}: ${primary.cpu}, ${primary.gpu}, ${primary.memory}, сборка ScoutPC в Краснодаре`} fetchpriority="high" />
      </picture>
    </section>
    <section class="product-section" id="variants">
      <div class="product-heading"><p>Два варианта платформы</p><h2>{product.name}: Intel и AMD — выберите платформу</h2><span>Подскажем, какой вариант лучше подходит под ваши игры, задачи и будущий апгрейд.</span></div>
      <div class="variant-grid">
        {product.variants.map((variant) => (
          <article class="variant-card">
            <picture><source media="(max-width: 640px)" srcset={variant.image480} /><img src={variant.image} loading="lazy" width="960" height="1280" alt={`Игровой ПК ${product.name} на платформе ${variant.platform}: ${variant.cpu}, ${variant.gpu}, ${variant.memory}`} /></picture>
            <div class="variant-copy"><p class="variant-platform">{variant.platform}</p><h3>{product.name} · {variant.platform}</h3><dl><div><dt>Процессор</dt><dd>{variant.cpu}</dd></div><div><dt>Видеокарта</dt><dd>{variant.gpu}</dd></div><div><dt>Память</dt><dd>{variant.memory}</dd></div><div><dt>Материнская плата</dt><dd>{variant.motherboard}</dd></div><div><dt>Охлаждение</dt><dd>{variant.cooling}</dd></div></dl><p class="variant-fps"><strong>{variant.averageFps} FPS</strong><span>ориентир по 10 играм, 1080p, высокие настройки</span></p></div>
          </article>
        ))}
      </div>
    </section>
    <section class="product-section product-fit"><div class="product-heading"><p>Кому подходит</p><h2>{product.resolution}</h2></div><ul>{product.bestFor.map(item => <li>{item}</li>)}</ul></section>
    <section class="product-section"><div class="product-heading"><p>Перед выдачей</p><h2>Не просто собираем — проверяем</h2></div><div class="product-proof"><article><strong>01</strong><h3>Согласуем детали</h3><p>Фиксируем состав, состояние комплектующих, цену и сроки.</p></article><article><strong>02</strong><h3>Собираем аккуратно</h3><p>Настраиваем BIOS, систему охлаждения и кабель-менеджмент.</p></article><article><strong>03</strong><h3>Тестируем 3 часа</h3><p>Проверяем стабильность и температуры в OCCT и FurMark.</p></article></div></section>
    <section class="product-section product-faq"><div class="product-heading"><p>Вопросы</p><h2>Что важно знать</h2></div>{faq.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</section>
    <section class="product-section">
      <div class="product-heading"><p>Другие модели</p><h2>Сравните серии ScoutPC</h2><span>От базовой до флагманской — подскажем, где заканчивается «достаточно» и начинается переплата.</span></div>
      <div class="model-links">
        {products.filter((item) => item.slug !== product.slug).map((item) => (
          <a href={`/${item.slug}.html`}>
            <strong>{item.name}</strong>
            <span>{shortGpu(item.variants[0].gpu)} · от {item.price.toLocaleString('ru-RU')} ₽</span>
          </a>
        ))}
      </div>
    </section>
    <section class="product-cta"><p>Подберём точную версию {product.name} под ваши игры и бюджет</p><h2>Свяжитесь с нами — предложим 1–2 сбалансированных варианта</h2><div class="product-cta-actions"><a href="https://t.me/Scout_PC" target="_blank">Получить конфигурацию</a><a class="product-phone" href="tel:+79531171331">+7 953 117-13-31</a></div></section>
  </main>
  <Fragment set:html={shellEnd} />
</BaseLayout>
